# Copy this to instaclustr.env and fill in your cluster details.
# instaclustr.env is gitignored — never commit real credentials.
#
# Find these values in the Instaclustr console:
#   Clusters → your cluster → Connection Info

# OpenSearch REST endpoint with credentials
# Format: https://<username>:<password>@<hostname>:9200
# Username and password come from Instaclustr console → Users tab
OPENSEARCH_URL=https://<username>:<password>@load-balancer.<cluster-id>.cnodes.io:9200

# SSL cert hostname — Instaclustr issues the cert for the base domain (without load-balancer.)
# Leave blank to auto-derive from OPENSEARCH_URL (strips 'load-balancer.' prefix)
# OPENSEARCH_SSL_HOSTNAME=<cluster-id>.cnodes.io

# ── Bedrock (Claude Sonnet) — for real AI-powered RCA ─────────────────────────
# When AWS_ACCESS_KEY_ID is set, setup_agent.sh uses Bedrock instead of mock-llm.
# The IAM user needs: bedrock:InvokeModel on the Claude Sonnet model.
AWS_ACCESS_KEY_ID=<your-access-key>
AWS_SECRET_ACCESS_KEY=<your-secret-key>
AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20251001-v1:0

# ── Mock LLM fallback (used when AWS creds are not set) ───────────────────────
MOCK_LLM_URL=http://<your-ec2-ip>:8765

# Public IP/hostname of the machine running mock-llm (port 8765).
# Must be reachable from Instaclustr's OpenSearch nodes.
# Examples:
#   EC2:   http://54.123.45.67:8765
#   ngrok: https://abc123.ngrok.io
MOCK_LLM_URL=http://<your-public-ip>:8765
